@page
@model LoginModel
@{
    ViewData["Title"] = "Iniciar sesión";
}

<div class="card mx-auto" style="max-width: 26rem;">
    <div class="card-body p-4">
        <h1 class="h4 mb-1 text-center"><i class="bi bi-fire" aria-hidden="true"></i> AlitasGo</h1>
        <p class="text-muted text-center mb-4">Ingresa con tu usuario personal</p>
        <form id="formLogin" method="post" asp-route-returnUrl="@Model.ReturnUrl" data-una-vez>
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2" role="alert"></div>
            <div class="mb-3">
                <label asp-for="Input.Email" class="form-label"></label>
                <input asp-for="Input.Email" class="form-control" autocomplete="username" autofocus />
                <span asp-validation-for="Input.Email" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Input.Password" class="form-label"></label>
                <input asp-for="Input.Password" class="form-control" autocomplete="current-password" />
                <span asp-validation-for="Input.Password" class="text-danger small"></span>
            </div>
            <button type="submit" class="btn btn-primary w-100 btn-lg">Ingresar</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

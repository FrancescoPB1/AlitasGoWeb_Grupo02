@model List<Pedido>
@{
    // Firma del tablero: si no cambia, la pantalla no se redibuja (no se pierde el foco del teclado).
    var firma = string.Join(",", Model.Select(p => $"{p.IdPedido}:{p.IdEstadoPedido}"));

    string Destino(Pedido p) => p.PedidoLocal != null
        ? $"Mesa {p.PedidoLocal.NroMesa?.NumeroMesa}"
        : "Delivery";

    string Linea(DetallePedido d) =>
        $"{d.Cantidad} {d.Producto?.Nombre}{(d.Sabor != null ? " " + d.Sabor.Nombre : "")}";

    // Texto que se lee en voz alta cuando llega el pedido.
    string Voz(Pedido p) =>
        $"Nuevo pedido número {p.IdPedido}. {Destino(p)}. " + string.Join(". ", p.DetallePedidos.Select(Linea)) + ".";
}
<div id="tablero" data-parcial data-firma="@firma">
    @if (!Model.Any())
    {
        <div class="text-center py-5">
            <i class="bi bi-check2-circle display-1" aria-hidden="true"></i>
            <p class="fs-2 mt-3">No hay pedidos pendientes</p>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var p in Model)
            {
                var minutos = (int)(DateTime.Now - p.Fecha).TotalMinutes;
                <div class="col-12 col-md-6 col-xxl-4">
                    <article class="ticket-cocina estado-@p.IdEstadoPedido" data-id="@p.IdPedido" data-voz="@Voz(p)"
                             aria-labelledby="ticket-@p.IdPedido">
                        <div class="d-flex justify-content-between align-items-start gap-2">
                            <h2 id="ticket-@p.IdPedido" class="ticket-cabecera mb-0">#@p.IdPedido · @Destino(p)</h2>
                            <span class="ticket-estado">@MaquinaEstadosPedido.Nombre(p.IdEstadoPedido)</span>
                        </div>
                        <div class="ticket-sub">
                            <i class="bi bi-clock" aria-hidden="true"></i> @p.Fecha.ToString("HH:mm") · hace @minutos min
                        </div>
                        <ul>
                            @foreach (var d in p.DetallePedidos)
                            {
                                <li>
                                    @d.Cantidad × @d.Producto?.Nombre
                                    @if (d.Sabor != null)
                                    {
                                        <span>— @d.Sabor.Nombre</span>
                                    }
                                    @if (d.Producto != null && d.Producto.Componentes.Any())
                                    {
                                        <small>
                                            @string.Join(" + ", d.Producto.Componentes.Select(c =>
                                                $"{c.Cantidad * d.Cantidad} {c.ProductoComponente?.Nombre}{(c.Sabor != null ? " " + c.Sabor.Nombre : "")}"))
                                        </small>
                                    }
                                </li>
                            }
                        </ul>
                        @if (p.IdEstadoPedido == Estados.Recibido)
                        {
                            <form asp-controller="Cocina" asp-action="Iniciar" asp-route-id="@p.IdPedido" method="post" class="js-accion-cocina">
                                <button type="submit" class="btn btn-warning btn-cocina">
                                    <i class="bi bi-fire" aria-hidden="true"></i> Empezar pedido #@p.IdPedido
                                </button>
                            </form>
                        }
                        else if (p.IdEstadoPedido == Estados.EnPreparacion)
                        {
                            <form asp-controller="Cocina" asp-action="MarcarListo" asp-route-id="@p.IdPedido" method="post" class="js-accion-cocina">
                                <button type="submit" class="btn btn-success btn-cocina">
                                    <i class="bi bi-check-lg" aria-hidden="true"></i> ¡Listo! pedido #@p.IdPedido
                                </button>
                            </form>
                        }
                    </article>
                </div>
            }
        </div>
    }
</div>

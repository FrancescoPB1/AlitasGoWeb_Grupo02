@model IEnumerable<Producto>
@{
    ViewData["Title"] = "Productos y precios";
}

<div class="page-header d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3 mb-4">
    <div>
        <h1 class="h3"><i class="bi bi-box-seam" aria-hidden="true"></i> Productos y precios</h1>
        <p class="text-muted mb-0">Los precios incluyen IGV. Cada cambio de precio queda en la bitácora.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg" aria-hidden="true"></i> Nuevo producto</a>
</div>

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>Nombre</th>
                    <th>Categoría</th>
                    <th>Tipo</th>
                    <th class="text-end">Precio</th>
                    <th>Sabor</th>
                    <th>Estado</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in Model)
                {
                    <tr class="@(p.Activo ? "" : "text-muted")">
                        <td class="fw-semibold">@p.Nombre</td>
                        <td>@p.CategoriaProducto?.Nombre</td>
                        <td>@p.TipoProducto?.Nombre</td>
                        <td class="text-end">S/ @p.Precio.ToString("0.00")</td>
                        <td>@(p.RequiereSabor ? "Sí" : "No")</td>
                        <td>
                            @if (p.Activo) { <span class="badge bg-success">Activo</span> }
                            else { <span class="badge bg-secondary">Inactivo</span> }
                        </td>
                        <td class="text-end acciones">
                            <div class="btn-group btn-group-sm" role="group" aria-label="Acciones">
                                <a asp-action="Edit" asp-route-id="@p.IdProducto" class="btn btn-outline-secondary" title="Editar">
                                    <i class="bi bi-pencil" aria-hidden="true"></i><span class="d-none d-md-inline"> Editar</span>
                                </a>
                                @if (!p.EsCombo)
                                {
                                    <a asp-action="Receta" asp-route-id="@p.IdProducto" class="btn btn-outline-secondary" title="Receta (insumos)">
                                        <i class="bi bi-list-check" aria-hidden="true"></i><span class="d-none d-md-inline"> Receta</span>
                                    </a>
                                }
                                else
                                {
                                    <a asp-action="Componentes" asp-route-id="@p.IdProducto" class="btn btn-outline-secondary" title="Productos del combo">
                                        <i class="bi bi-collection" aria-hidden="true"></i><span class="d-none d-md-inline"> Productos</span>
                                    </a>
                                }
                                @if (p.Activo)
                                {
                                    <button type="button" class="btn btn-outline-danger" title="Desactivar"
                                            data-bs-toggle="modal" data-bs-target="#modalEliminar"
                                            data-url="@Url.Action("Delete", new { id = p.IdProducto })"
                                            data-nombre="el producto «@p.Nombre»"
                                            data-detalle="Se marcará como inactivo; los pedidos anteriores lo conservan.">
                                        <i class="bi bi-trash3" aria-hidden="true"></i>
                                    </button>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

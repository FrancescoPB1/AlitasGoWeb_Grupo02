@model IEnumerable<Producto>
@{
    ViewData["Title"] = "Productos";
    var total = Model.Count();
}

<div class="page-header d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3 mb-4">
    <div>
        <h1 class="h3"><i class="bi bi-box-seam" aria-hidden="true"></i> Productos</h1>
        <p class="text-muted mb-0">Catálogo base. Los precios y tamaños se gestionan en cada producto.</p>
    </div>
    <div class="d-grid d-sm-block">
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-lg" aria-hidden="true"></i> Nuevo producto
        </a>
    </div>
</div>

<div class="card">
    @if (!Model.Any())
    {
        <div class="card-body text-center py-5 text-muted">
            <i class="bi bi-box-seam display-5 d-block mb-2" aria-hidden="true"></i>
            <p class="mb-3">Aún no hay productos registrados.</p>
            <a asp-action="Create" class="btn btn-outline-primary">Crear el primero</a>
        </div>
    }
    else
    {
        <div class="card-header bg-white d-flex justify-content-between align-items-center">
            <span class="fw-semibold">Listado</span>
            <span class="badge bg-secondary">@total</span>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th class="d-none d-lg-table-cell" style="width:5rem">ID</th>
                        <th>Nombre</th>
                        <th class="d-none d-md-table-cell">Categoría</th>
                        <th class="d-none d-md-table-cell">Tipo</th>
                        <th style="width:7rem">Estado</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in Model)
                    {
                        var categoria = p.CategoriaProducto?.Nombre ?? "Sin categoría";
                        var tipo = p.TipoProducto?.Nombre ?? "Sin tipo";
                        <tr>
                            <td class="d-none d-lg-table-cell text-muted">@p.IdProducto</td>
                            <td>
                                <div class="fw-semibold">@p.Nombre</div>
                                
                                <div class="small text-muted d-md-none">@categoria · @tipo</div>
                                @if (!string.IsNullOrWhiteSpace(p.Descripcion))
                                {
                                    <div class="small text-muted d-none d-lg-block text-truncate" style="max-width:22rem">@p.Descripcion</div>
                                }
                            </td>
                            <td class="d-none d-md-table-cell"><span class="badge bg-info text-dark">@categoria</span></td>
                            <td class="d-none d-md-table-cell"><span class="badge bg-warning text-dark">@tipo</span></td>
                            <td>
                                @if (p.Activo)
                                {
                                    <span class="badge bg-success">Activo</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Inactivo</span>
                                }
                            </td>
                            <td class="text-end acciones">
                                <div class="btn-group btn-group-sm" role="group" aria-label="Acciones">
                                    <a asp-controller="PresentacionProducto" asp-action="Index" asp-route-idProducto="@p.IdProducto"
                                       class="btn btn-outline-primary" title="Precios y tamaños">
                                        <i class="bi bi-currency-dollar" aria-hidden="true"></i>
                                        <span class="d-none d-xl-inline">Precios</span>
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@p.IdProducto"
                                       class="btn btn-outline-secondary" title="Editar">
                                        <i class="bi bi-pencil" aria-hidden="true"></i>
                                        <span class="d-none d-xl-inline">Editar</span>
                                    </a>
                                    <button type="button" class="btn btn-outline-danger" title="Eliminar"
                                            data-bs-toggle="modal" data-bs-target="#modalEliminar"
                                            data-url="@Url.Action("Delete", new { id = p.IdProducto })"
                                            data-nombre="el producto «@p.Nombre»"
                                            data-detalle="El producto se marcará como inactivo.">
                                        <i class="bi bi-trash3" aria-hidden="true"></i>
                                        <span class="d-none d-xl-inline">Eliminar</span>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

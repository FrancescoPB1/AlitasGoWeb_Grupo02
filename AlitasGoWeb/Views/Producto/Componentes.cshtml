@model ComponentesComboVM
@{
    ViewData["Title"] = $"Productos del combo · {Model.Combo.Nombre}";
}

<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb mb-0">
        <li class="breadcrumb-item"><a asp-action="Index">Productos</a></li>
        <li class="breadcrumb-item active" aria-current="page">Productos del combo</li>
    </ol>
</nav>

<div class="page-header mb-4">
    <h1 class="h3"><i class="bi bi-collection" aria-hidden="true"></i> Productos de «@Model.Combo.Nombre»</h1>
    <p class="text-muted mb-0">
        Precio del combo: <strong>S/ @Model.Combo.Precio.ToString("0.00")</strong>.
        Al venderlo se descuenta del stock la receta de cada producto por la cantidad indicada.
    </p>
</div>

<div class="row g-3">
    <div class="col-lg-7">
        <div class="card">
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <caption class="visually-hidden">Productos que forman el combo</caption>
                    <thead><tr><th scope="col">Producto</th><th scope="col">Sabor</th><th scope="col" class="text-end">Cantidad</th><th scope="col"><span class="visually-hidden">Quitar</span></th></tr></thead>
                    <tbody>
                        @if (!Model.Lineas.Any())
                        {
                            <tr><td colspan="4" class="text-center text-muted py-4">Este combo aún no tiene productos.</td></tr>
                        }
                        @foreach (var c in Model.Lineas)
                        {
                            <tr>
                                <td class="fw-semibold">@c.ProductoComponente?.Nombre</td>
                                <td>@(c.Sabor?.Nombre ?? "Sin sabor")</td>
                                <td class="text-end">× @c.Cantidad</td>
                                <td class="text-end">
                                    <form asp-action="QuitarComponente" asp-route-id="@Model.Combo.IdProducto" method="post">
                                        <input type="hidden" name="idComponente" value="@c.IdProductoComponente" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger" title="Quitar">
                                            <i class="bi bi-x-lg" aria-hidden="true"></i><span class="visually-hidden">Quitar @c.ProductoComponente?.Nombre</span>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="col-lg-5">
        <div class="card">
            <div class="card-header bg-white fw-semibold">Agregar producto</div>
            <div class="card-body">
                <form asp-action="AgregarComponente" asp-route-id="@Model.Combo.IdProducto" method="post">
                    <div class="mb-3">
                        <label asp-for="Nuevo.IdProducto" class="form-label"></label>
                        <select asp-for="Nuevo.IdProducto" class="form-select" required>
                            <option value="">-- Selecciona --</option>
                            @foreach (var p in Model.Productos)
                            {
                                <option value="@p.IdProducto" data-sabor="@(p.RequiereSabor ? "1" : "0")">@p.Nombre · S/ @p.Precio.ToString("0.00")</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Nuevo.IdSabor" class="form-label"></label>
                        <select asp-for="Nuevo.IdSabor" asp-items="Model.Sabores" class="form-select">
                            <option value="">Sin sabor</option>
                        </select>
                        <div class="form-text">Solo para productos que llevan sabor (alitas, boneless).</div>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Nuevo.Cantidad" class="form-label"></label>
                        <input asp-for="Nuevo.Cantidad" type="number" step="1" min="1" max="20" class="form-control" required />
                    </div>
                    <button type="submit" class="btn btn-primary w-100"><i class="bi bi-plus-lg" aria-hidden="true"></i> Agregar</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            // El sabor solo se elige si el producto lo lleva.
            var producto = document.getElementById('Nuevo_IdProducto');
            var sabor = document.getElementById('Nuevo_IdSabor');
            function actualizar() {
                var op = producto.selectedOptions[0];
                var llevaSabor = op && op.dataset.sabor === '1';
                if (!llevaSabor) sabor.value = '';
                sabor.disabled = !llevaSabor;
                sabor.required = llevaSabor;
            }
            producto.addEventListener('change', actualizar);
            actualizar();
        })();
    </script>
}

@model Producto
@{
    bool isEdit = ViewBag.IsEdit ?? false;
    ViewData["Title"] = isEdit ? "Editar producto" : "Nuevo producto";
}

<div class="row justify-content-center">
    <div class="col-12 col-md-9 col-lg-7">

        <nav aria-label="breadcrumb" class="mb-3">
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a asp-action="Index">Productos</a></li>
                <li class="breadcrumb-item active" aria-current="page">@ViewData["Title"]</li>
            </ol>
        </nav>

        <div class="card">
            <div class="card-header bg-white">
                <h1 class="h5 mb-0"><i class="bi bi-box-seam" aria-hidden="true"></i> @ViewData["Title"]</h1>
            </div>
            <div class="card-body">
                <form asp-action="@(isEdit ? "Edit" : "Create")" asp-route-id="@(isEdit ? Model.IdProducto : null)" method="post" data-una-vez>
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2" role="alert"></div>

                    @if (isEdit)
                    {
                        <input type="hidden" asp-for="IdProducto" />
                    }
                    else
                    {
                        <input type="hidden" asp-for="Activo" value="true" />
                    }

                    <div class="mb-3">
                        <label asp-for="Nombre" class="form-label"></label>
                        <input asp-for="Nombre" class="form-control" autofocus />
                        <span asp-validation-for="Nombre" class="text-danger small"></span>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-sm-6">
                            <label asp-for="IdCategoriaProducto" class="form-label"></label>
                            <select asp-for="IdCategoriaProducto" asp-items="ViewBag.CategoriaProductos" class="form-select">
                                <option value="0">-- Selecciona --</option>
                            </select>
                            <span asp-validation-for="IdCategoriaProducto" class="text-danger small"></span>
                        </div>
                        <div class="col-sm-6">
                            <label asp-for="IdTipoProducto" class="form-label"></label>
                            <select asp-for="IdTipoProducto" asp-items="ViewBag.TipoProductos" class="form-select">
                                <option value="0">-- Selecciona --</option>
                            </select>
                            <span asp-validation-for="IdTipoProducto" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-sm-6">
                            <label asp-for="Precio" class="form-label"></label>
                            <div class="input-group">
                                <span class="input-group-text">S/</span>
                                <input asp-for="Precio" class="form-control" type="number" step="0.10" min="0.10" max="999" />
                            </div>
                            <span asp-validation-for="Precio" class="text-danger small"></span>
                        </div>
                        <div class="col-sm-6 d-flex align-items-end">
                            <div class="form-check form-switch mb-2">
                                <input asp-for="RequiereSabor" class="form-check-input" role="switch" />
                                <label asp-for="RequiereSabor" class="form-check-label"></label>
                            </div>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Descripcion" class="form-label"></label>
                        <textarea asp-for="Descripcion" class="form-control" rows="2"></textarea>
                        <span asp-validation-for="Descripcion" class="text-danger small"></span>
                    </div>

                    @if (isEdit)
                    {
                        <partial name="_RecetaActual" model="Model" />
                    }
                    else
                    {
                        <partial name="_Ingredientes" />
                        <partial name="_Componentes" />
                    }

                    @if (isEdit)
                    {
                        <div class="form-check form-switch mb-3">
                            <input asp-for="Activo" class="form-check-input" role="switch" />
                            <label asp-for="Activo" class="form-check-label">Producto activo (visible al tomar pedidos)</label>
                        </div>
                    }

                    <div class="d-flex justify-content-between">
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                        <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg" aria-hidden="true"></i> Guardar</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    @if (!isEdit)
    {
        <script>
            (function () {
                AlitasGo.filasDinamicas({ cuerpo: 'filasIngredientes', plantilla: 'plantillaIngrediente', botonAgregar: 'btnAgregarIngrediente', prefijo: 'Ingredientes', alAgregar: actualizar });
                AlitasGo.filasDinamicas({ cuerpo: 'filasComponentes', plantilla: 'plantillaComponente', botonAgregar: 'btnAgregarComponente', prefijo: 'Componentes', alAgregar: actualizar });

                var tipo = document.getElementById('IdTipoProducto');
                var requiereSabor = document.getElementById('RequiereSabor');
                var ingredientes = document.getElementById('seccionIngredientes');
                var componentes = document.getElementById('seccionComponentes');
                var TIPO_COMBO = '@Producto.IdTipoCombo';

                // Combo: se arma con productos (no con ingredientes) y no pide sabor al tomar el pedido.
                // Producto normal: la columna «Sabor» de los ingredientes solo aplica si el producto lleva sabor.
                function actualizar() {
                    var esCombo = tipo.value === TIPO_COMBO;
                    ingredientes.hidden = ingredientes.disabled = esCombo;
                    componentes.hidden = componentes.disabled = !esCombo;
                    if (esCombo) requiereSabor.checked = false;
                    requiereSabor.disabled = esCombo;

                    document.querySelectorAll('#filasIngredientes .js-sabor').forEach(function (s) {
                        if (!requiereSabor.checked) s.value = '';
                        s.disabled = !requiereSabor.checked;
                    });
                    // En el combo, el sabor solo se elige para los productos que lo llevan (alitas, boneless).
                    document.querySelectorAll('#filasComponentes [data-fila]').forEach(function (fila) {
                        var producto = fila.querySelector('.js-producto');
                        var sabor = fila.querySelector('.js-sabor-combo');
                        var llevaSabor = producto.selectedOptions[0] && producto.selectedOptions[0].dataset.sabor === '1';
                        if (!llevaSabor) sabor.value = '';
                        sabor.disabled = !esCombo || !llevaSabor;
                    });
                }
                tipo.addEventListener('change', actualizar);
                requiereSabor.addEventListener('change', actualizar);
                document.getElementById('filasComponentes').addEventListener('change', function (e) {
                    if (e.target.classList.contains('js-producto')) actualizar();
                });
                actualizar();
            })();
        </script>
    }
}

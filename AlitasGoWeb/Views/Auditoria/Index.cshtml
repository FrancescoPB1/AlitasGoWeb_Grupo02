@model RangoFechasVM<List<Auditoria>>
@{
    ViewData["Title"] = "Bitácora";
}

<div class="page-header d-flex flex-column flex-lg-row justify-content-between align-items-lg-end gap-3 mb-4">
    <div>
        <h1 class="h3"><i class="bi bi-journal-text" aria-hidden="true"></i> Bitácora de auditoría</h1>
        <p class="text-muted mb-0">Anulaciones, cambios de precio, stock, usuarios y accesos denegados.</p>
    </div>
    <form method="get" class="d-flex gap-2 align-items-end flex-wrap">
        <div>
            <label for="desde" class="form-label small mb-1">Desde</label>
            <input type="date" id="desde" name="desde" class="form-control" value="@Model.Desde.ToString("yyyy-MM-dd")" />
        </div>
        <div>
            <label for="hasta" class="form-label small mb-1">Hasta</label>
            <input type="date" id="hasta" name="hasta" class="form-control" value="@Model.Hasta.ToString("yyyy-MM-dd")" />
        </div>
        <button type="submit" class="btn btn-primary">Ver</button>
    </form>
</div>

<div class="card">
    <div class="table-responsive">
        <table class="table table-sm table-hover align-middle mb-0">
            <thead><tr><th>Fecha</th><th>Usuario</th><th>Acción</th><th>Entidad</th><th>Detalle</th></tr></thead>
            <tbody>
                @if (!Model.Datos.Any())
                {
                    <tr><td colspan="5" class="text-center text-muted py-4">Sin registros en el rango.</td></tr>
                }
                @foreach (var a in Model.Datos)
                {
                    <tr class="@(a.Accion == "Acceso denegado" ? "table-warning" : "")">
                        <td class="text-nowrap">@a.Fecha.ToString("dd/MM/yyyy HH:mm")</td>
                        <td class="small">@a.Usuario</td>
                        <td class="fw-semibold">@a.Accion</td>
                        <td class="small">@a.Entidad @(string.IsNullOrEmpty(a.IdEntidad) ? "" : "#" + a.IdEntidad)</td>
                        <td class="small">@a.Detalle</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

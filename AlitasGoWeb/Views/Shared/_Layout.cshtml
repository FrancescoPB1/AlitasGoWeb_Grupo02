@{
    var controladorActual = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    string Activo(string controlador) =>
        string.Equals(controladorActual, controlador, StringComparison.OrdinalIgnoreCase) ? "active" : "";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] · AlitasGo</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100">

    <header>
        <nav class="navbar navbar-expand-md navbar-dark bg-dark shadow-sm">
            <div class="container">
                <a class="navbar-brand fw-bold d-flex align-items-center gap-2" asp-controller="Producto" asp-action="Index">
                    <i class="bi bi-fire" aria-hidden="true"></i> AlitasGo
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navPrincipal"
                        aria-controls="navPrincipal" aria-expanded="false" aria-label="Abrir menú">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navPrincipal">
                    <ul class="navbar-nav ms-auto">
                        <li class="nav-item">
                            <a class="nav-link @Activo("CategoriaProducto")" asp-controller="CategoriaProducto" asp-action="Index">
                                <i class="bi bi-tags" aria-hidden="true"></i> Categorías
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @Activo("Producto")" asp-controller="Producto" asp-action="Index">
                                <i class="bi bi-box-seam" aria-hidden="true"></i> Productos
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @Activo("PresentacionProducto")" asp-controller="PresentacionProducto" asp-action="Index">
                                <i class="bi bi-box2" aria-hidden="true"></i> Presentaciones
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main class="flex-grow-1 py-4">
        <div class="container">
            <partial name="_AlertasPartial" />
            @RenderBody()
        </div>
    </main>

    <footer class="bg-dark text-white-50 py-3 mt-auto">
        <div class="container text-center small">
            &copy; @DateTime.Now.Year AlitasGo · Grupo 02
        </div>
    </footer>

    <partial name="_ConfirmarEliminarModal" />

   
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

@model Insumo
@{
    bool isEdit = ViewBag.IsEdit ?? false;
    ViewData["Title"] = isEdit ? "Editar insumo" : "Nuevo insumo";
}

<div class="page-header mb-4">
    <h1 class="h3"><i class="bi bi-basket" aria-hidden="true"></i> @ViewData["Title"]</h1>
</div>

<div class="card" style="max-width: 40rem;">
    <div class="card-body">
        <form asp-action="@(isEdit ? "Edit" : "Create")" asp-route-id="@(isEdit ? Model.IdInsumo : null)" method="post" data-una-vez>
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2" role="alert"></div>
            @if (isEdit)
            {
                <input type="hidden" asp-for="IdInsumo" />
            }
            <div class="mb-3">
                <label asp-for="Nombre" class="form-label"></label>
                <input asp-for="Nombre" class="form-control" autofocus />
                <span asp-validation-for="Nombre" class="text-danger small"></span>
            </div>
            <div class="row g-3 mb-3">
                <div class="col-sm-4">
                    <label asp-for="UnidadMedida" class="form-label"></label>
                    <input asp-for="UnidadMedida" class="form-control" placeholder="kg, lt, unidad" />
                    <span asp-validation-for="UnidadMedida" class="text-danger small"></span>
                </div>
                @if (!isEdit)
                {
                    <div class="col-sm-4">
                        <label asp-for="StockActual" class="form-label">Stock inicial</label>
                        <input asp-for="StockActual" type="number" step="0.01" min="0" class="form-control" />
                    </div>
                }
                else
                {
                    <div class="col-sm-4">
                        <span class="form-label d-block">Stock actual</span>
                        <div class="form-control-plaintext fw-semibold">@Model.StockActual.ToString("0.##")</div>
                    </div>
                }
                <div class="col-sm-4">
                    <label asp-for="StockMinimo" class="form-label"></label>
                    <input asp-for="StockMinimo" type="number" step="0.01" min="0" class="form-control" />
                    <span asp-validation-for="StockMinimo" class="text-danger small"></span>
                </div>
            </div>
            @if (isEdit)
            {
                <p class="small text-muted">El stock no se edita a mano: sube con compras y baja con pedidos, para que cada cambio quede registrado.</p>
            }
            <div class="d-flex justify-content-between">
                <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg" aria-hidden="true"></i> Guardar</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

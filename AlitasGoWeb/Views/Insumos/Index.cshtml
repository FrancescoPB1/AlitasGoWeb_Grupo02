@model List<Insumo>
@{
    ViewData["Title"] = "Insumos y stock";
    var bajos = Model.Count(i => i.BajoMinimo);
}

<div class="page-header d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h1 class="h3"><i class="bi bi-basket" aria-hidden="true"></i> Insumos y stock</h1>
        <p class="text-muted mb-0">El stock baja con cada pedido y sube con cada compra.</p>
    </div>
    <div class="d-flex gap-2 flex-wrap">
        <a asp-action="Compra" class="btn btn-primary"><i class="bi bi-cart-plus" aria-hidden="true"></i> Registrar compra</a>
        <a asp-action="Create" class="btn btn-outline-primary"><i class="bi bi-plus-lg" aria-hidden="true"></i> Nuevo insumo</a>
        <a asp-action="Movimientos" class="btn btn-outline-secondary"><i class="bi bi-arrow-left-right" aria-hidden="true"></i> Movimientos</a>
    </div>
</div>

@if (bajos > 0)
{
    <div class="alert alert-warning d-flex align-items-center gap-2" role="alert">
        <i class="bi bi-exclamation-triangle-fill fs-5" aria-hidden="true"></i>
        <div><strong>@bajos insumo(s)</strong> están en o por debajo del stock mínimo: conviene comprar antes del fin de semana.</div>
    </div>
}

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr><th>Insumo</th><th>Unidad</th><th class="text-end">Stock actual</th><th class="text-end">Mínimo</th><th>Estado</th><th class="text-end">Acciones</th></tr>
            </thead>
            <tbody>
                @foreach (var i in Model)
                {
                    <tr class="@(i.BajoMinimo ? "table-warning" : "")">
                        <td class="fw-semibold">@i.Nombre</td>
                        <td>@i.UnidadMedida</td>
                        <td class="text-end fw-semibold">@i.StockActual.ToString("0.##")</td>
                        <td class="text-end">@i.StockMinimo.ToString("0.##")</td>
                        <td>
                            @if (i.BajoMinimo) { <span class="badge bg-danger">Bajo mínimo</span> }
                            else { <span class="badge bg-success">OK</span> }
                        </td>
                        <td class="text-end acciones">
                            <div class="btn-group btn-group-sm">
                                <a asp-action="Compra" asp-route-idInsumo="@i.IdInsumo" class="btn btn-outline-primary">Comprar</a>
                                <a asp-action="Movimientos" asp-route-idInsumo="@i.IdInsumo" class="btn btn-outline-secondary">Movimientos</a>
                                <a asp-action="Edit" asp-route-id="@i.IdInsumo" class="btn btn-outline-secondary">Editar</a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@model CompraVM
@{
    ViewData["Title"] = "Registrar compra";
}

<div class="page-header mb-4">
    <h1 class="h3"><i class="bi bi-cart-plus" aria-hidden="true"></i> Registrar compra de insumos</h1>
    <p class="text-muted mb-0">Cada línea suma al stock y queda como movimiento de entrada.</p>
</div>

<form asp-action="Compra" method="post" data-una-vez>
    <div asp-validation-summary="All" class="alert alert-danger py-2" role="alert"></div>
    <div class="card mb-3">
        <div class="card-header bg-white d-flex justify-content-between align-items-center">
            <span class="fw-semibold">Insumos comprados</span>
            <button type="button" id="btnAgregarLinea" class="btn btn-sm btn-outline-primary"><i class="bi bi-plus-lg" aria-hidden="true"></i> Agregar línea</button>
        </div>
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead><tr><th>Insumo</th><th style="width:10rem">Cantidad</th><th style="width:12rem">Costo unitario (S/)</th><th style="width:4rem"></th></tr></thead>
                <tbody id="filasCompra">
                    @for (var i = 0; i < Model.Lineas.Count; i++)
                    {
                        <tr data-fila>
                            <td>
                                <select asp-for="Lineas[i].IdInsumo" asp-items="Model.Insumos" class="form-select" aria-label="Insumo">
                                    <option value="0">-- Selecciona --</option>
                                </select>
                            </td>
                            <td><input asp-for="Lineas[i].Cantidad" type="number" step="0.01" min="0.01" class="form-control" aria-label="Cantidad" /></td>
                            <td><input asp-for="Lineas[i].CostoUnitario" type="number" step="0.01" min="0" class="form-control" aria-label="Costo unitario" /></td>
                            <td class="text-end"><button type="button" class="btn btn-sm btn-outline-danger js-quitar-fila" title="Quitar"><i class="bi bi-x-lg" aria-hidden="true"></i><span class="visually-hidden">Quitar</span></button></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <template id="plantillaCompra">
        <tr data-fila>
            <td>
                <select name="Lineas[__i__].IdInsumo" id="Lineas___i____IdInsumo" class="form-select" aria-label="Insumo">
                    <option value="0">-- Selecciona --</option>
                    @foreach (var op in Model.Insumos)
                    {
                        <option value="@op.Value">@op.Text</option>
                    }
                </select>
            </td>
            <td><input name="Lineas[__i__].Cantidad" id="Lineas___i____Cantidad" type="number" step="0.01" min="0.01" class="form-control" aria-label="Cantidad" /></td>
            <td><input name="Lineas[__i__].CostoUnitario" id="Lineas___i____CostoUnitario" type="number" step="0.01" min="0" class="form-control" aria-label="Costo unitario" /></td>
            <td class="text-end"><button type="button" class="btn btn-sm btn-outline-danger js-quitar-fila" title="Quitar"><i class="bi bi-x-lg" aria-hidden="true"></i><span class="visually-hidden">Quitar</span></button></td>
        </tr>
    </template>

    <div class="d-flex justify-content-between">
        <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
        <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg" aria-hidden="true"></i> Registrar compra</button>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        AlitasGo.filasDinamicas({ cuerpo: 'filasCompra', plantilla: 'plantillaCompra', botonAgregar: 'btnAgregarLinea', prefijo: 'Lineas' });
    </script>
}

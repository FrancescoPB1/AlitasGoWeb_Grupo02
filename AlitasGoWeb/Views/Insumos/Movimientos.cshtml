@model List<MovimientoInventario>
@using Microsoft.AspNetCore.Mvc.Rendering
@{
    ViewData["Title"] = "Movimientos de inventario";
    var insumos = ViewData["Insumos"] as List<SelectListItem> ?? new();
}

<div class="page-header d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h1 class="h3"><i class="bi bi-arrow-left-right" aria-hidden="true"></i> Movimientos de inventario</h1>
        <p class="text-muted mb-0">Últimos 300 movimientos: salidas por pedidos, entradas por compras y anulaciones.</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left" aria-hidden="true"></i> Insumos</a>
</div>

<form method="get" class="card card-body mb-3">
    <div class="row g-2 align-items-end">
        <div class="col-sm-6 col-lg-4">
            <label for="idInsumo" class="form-label small mb-1">Insumo</label>
            <select id="idInsumo" name="idInsumo" class="form-select" asp-items="insumos">
                <option value="">Todos</option>
            </select>
        </div>
        <div class="col-sm-3 col-lg-2 d-grid">
            <button type="submit" class="btn btn-outline-secondary">Filtrar</button>
        </div>
    </div>
</form>

<div class="card">
    <div class="table-responsive">
        <table class="table table-sm table-hover align-middle mb-0">
            <thead><tr><th>Fecha</th><th>Insumo</th><th>Tipo</th><th class="text-end">Cantidad</th><th>Motivo</th><th>Pedido</th><th>Usuario</th></tr></thead>
            <tbody>
                @foreach (var m in Model)
                {
                    <tr>
                        <td>@m.Fecha.ToString("dd/MM HH:mm")</td>
                        <td>@m.Insumo?.Nombre</td>
                        <td>
                            @if (m.Tipo == TiposMovimiento.Entrada) { <span class="badge bg-success">Entrada</span> }
                            else { <span class="badge bg-danger">Salida</span> }
                        </td>
                        <td class="text-end">@m.Cantidad.ToString("0.##") @m.Insumo?.UnidadMedida</td>
                        <td>@m.Motivo</td>
                        <td>@(m.IdPedido.HasValue ? "#" + m.IdPedido : "—")</td>
                        <td class="small">@m.Usuario</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

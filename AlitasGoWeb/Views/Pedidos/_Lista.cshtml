@model PedidosIndexVM
<div data-parcial>
    <div class="card">
        @if (!Model.Pedidos.Any())
        {
            <div class="card-body text-center py-5 text-muted">
                <i class="bi bi-receipt display-5 d-block mb-2" aria-hidden="true"></i>
                No hay pedidos para los filtros elegidos.
            </div>
        }
        else
        {
            <div class="card-header bg-white d-flex justify-content-between align-items-center">
                <span class="fw-semibold">@Model.Fecha.ToString("dddd dd/MM/yyyy")</span>
                <span class="badge bg-secondary">@Model.Pedidos.Count</span>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th>N.°</th>
                            <th>Hora</th>
                            <th>Cliente</th>
                            <th>Canal</th>
                            <th>Estado</th>
                            <th class="text-end">Total</th>
                            <th class="text-end">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in Model.Pedidos)
                        {
                            <tr>
                                <td class="fw-semibold">#@p.IdPedido</td>
                                <td>@p.Fecha.ToString("HH:mm")</td>
                                <td>@p.Cliente?.Nombre @p.Cliente?.ApellidoPaterno</td>
                                <td>
                                    @if (p.PedidoLocal != null)
                                    {
                                        <span><i class="bi bi-shop" aria-hidden="true"></i> Mesa @p.PedidoLocal.NroMesa?.NumeroMesa</span>
                                    }
                                    else
                                    {
                                        <span><i class="bi bi-bicycle" aria-hidden="true"></i> @p.PedidoDelivery?.ZonaDelivery?.NombreZona</span>
                                    }
                                </td>
                                <td><partial name="_EstadoBadge" model="p.IdEstadoPedido" /></td>
                                <td class="text-end">S/ @p.Total.ToString("0.00")</td>
                                <td class="text-end acciones">
                                    <div class="btn-group btn-group-sm">
                                        <a asp-action="Details" asp-route-id="@p.IdPedido" class="btn btn-outline-secondary">
                                            <i class="bi bi-eye" aria-hidden="true"></i> Ver
                                        </a>
                                        @if (MaquinaEstadosPedido.PuedeEditar(p.IdEstadoPedido))
                                        {
                                            <a asp-action="Edit" asp-route-id="@p.IdPedido" class="btn btn-outline-primary">
                                                <i class="bi bi-pencil" aria-hidden="true"></i> Editar
                                            </a>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

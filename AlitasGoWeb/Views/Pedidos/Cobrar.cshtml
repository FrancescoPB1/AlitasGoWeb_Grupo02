@model CobroVM
@{
    ViewData["Title"] = $"Cobrar pedido #{Model.IdPedido}";
}

<div class="page-header mb-4">
    <h1 class="h3"><i class="bi bi-cash-coin" aria-hidden="true"></i> Cobrar pedido #@Model.IdPedido</h1>
    <p class="text-muted mb-0">Los precios ya incluyen IGV. Al cobrar, el pedido pasa a Entregado.</p>
</div>

<div class="row g-3">
    <div class="col-lg-7">
        <div class="card">
            <div class="card-header bg-white fw-semibold">Detalle</div>
            @if (Model.Pedido != null)
            {
                <partial name="_DetalleLineas" model="Model.Pedido" />
            }
        </div>
    </div>
    <div class="col-lg-5">
        <div class="card">
            <div class="card-body">
                @if (Model.Pedido != null)
                {
                    <partial name="_ResumenPedido" model="Model.Pedido" />
                    <hr />
                }
                <partial name="_FormCobro" model="Model" />
            </div>
        </div>
        <a asp-action="Details" asp-route-id="@Model.IdPedido" class="btn btn-link mt-2">
            <i class="bi bi-arrow-left" aria-hidden="true"></i> Volver al pedido
        </a>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

@model Pedido
@using Microsoft.AspNetCore.Authorization
@inject IAuthorizationService Autorizacion
@{
    ViewData["Title"] = $"Pedido #{Model.IdPedido}";
    var puedeAnular = MaquinaEstadosPedido.PuedeAnular(Model.IdEstadoPedido)
                      && (await Autorizacion.AuthorizeAsync(User, Politicas.AnularPedido)).Succeeded;
    var esAdminSinMfa = User.IsInRole(RolesSistema.Administrador) && !puedeAnular && MaquinaEstadosPedido.PuedeAnular(Model.IdEstadoPedido);
}

<div class="page-header d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h1 class="h3 d-flex align-items-center gap-2">
            <i class="bi bi-receipt" aria-hidden="true"></i> Pedido #@Model.IdPedido
            <partial name="_EstadoBadge" model="Model.IdEstadoPedido" />
        </h1>
        <p class="text-muted mb-0">Registrado @Model.Fecha.ToString("dd/MM/yyyy HH:mm") por @(Model.UsuarioRegistro ?? "—")</p>
    </div>
    <div class="d-flex gap-2 flex-wrap">
        @if (MaquinaEstadosPedido.PuedeEditar(Model.IdEstadoPedido))
        {
            <a asp-action="Edit" asp-route-id="@Model.IdPedido" class="btn btn-outline-primary">
                <i class="bi bi-pencil" aria-hidden="true"></i> Editar
            </a>
        }
        @if (!Model.EsDelivery && Model.IdEstadoPedido == Estados.Listo)
        {
            <form asp-action="MarcarServido" asp-route-id="@Model.IdPedido" method="post">
                <button type="submit" class="btn btn-success"><i class="bi bi-cup-hot" aria-hidden="true"></i> Marcar servido</button>
            </form>
        }
        @if (MaquinaEstadosPedido.PuedeCobrar(Model.IdEstadoPedido, Model.EsDelivery) && !Model.EsDelivery)
        {
            <a asp-action="Cobrar" asp-route-id="@Model.IdPedido" class="btn btn-primary">
                <i class="bi bi-cash-coin" aria-hidden="true"></i> Cobrar
            </a>
        }
        @if (Model.Pago != null)
        {
            <a asp-action="Comprobante" asp-route-id="@Model.IdPedido" class="btn btn-outline-secondary">
                <i class="bi bi-printer" aria-hidden="true"></i> Comprobante
            </a>
        }
        <a asp-action="Index" asp-route-fecha="@Model.Fecha.ToString("yyyy-MM-dd")" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left" aria-hidden="true"></i> Volver
        </a>
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-4">
        <div class="card h-100">
            <div class="card-header bg-white fw-semibold">Datos del pedido</div>
            <div class="card-body">
                <partial name="_ResumenPedido" model="Model" />
                @if (Model.IdEstadoPedido == Estados.Anulado)
                {
                    <div class="alert alert-danger mt-3 mb-0">
                        <strong>Motivo de anulación:</strong> @Model.MotivoAnulacion
                    </div>
                }
                @if (Model.Pago != null)
                {
                    <div class="alert alert-success mt-3 mb-0 small">
                        <strong>@Model.Pago.TipoComprobante @Model.Pago.NumeroComprobante</strong><br />
                        @Model.Pago.TipoPago?.Nombre · @Model.Pago.FechaPago.ToString("dd/MM/yyyy HH:mm")
                        · cobró @Model.Pago.UsuarioCobro
                    </div>
                }
                @if (Model.EsDelivery && Model.IdEstadoPedido is Estados.Listo or Estados.EnReparto)
                {
                    <div class="alert alert-info mt-3 mb-0 small">
                        El despacho y el cobro contra entrega se registran desde
                        <a asp-controller="Reparto" asp-action="Index">Reparto</a>.
                    </div>
                }
            </div>
        </div>
    </div>
    <div class="col-lg-8">
        <div class="card">
            <div class="card-header bg-white fw-semibold">Detalle</div>
            <partial name="_DetalleLineas" model="Model" />
        </div>

        @if (puedeAnular)
        {
            <div class="card mt-3 border border-danger">
                <div class="card-body">
                    <h2 class="h6 text-danger"><i class="bi bi-x-octagon" aria-hidden="true"></i> Anular pedido</h2>
                    <p class="small text-muted mb-2">
                        @(MaquinaEstadosPedido.DebeReponerStock(Model.IdEstadoPedido)
                            ? "Como la cocina aún no lo termina, los insumos vuelven al stock."
                            : "El pedido ya se preparó: los insumos NO vuelven al stock.")
                        La anulación queda registrada en la bitácora.
                    </p>
                    <form asp-action="Anular" asp-route-id="@Model.IdPedido" method="post" class="row g-2">
                        <div class="col-md-9">
                            <label for="motivo" class="visually-hidden">Motivo</label>
                            <input id="motivo" name="motivo" class="form-control" required minlength="5" maxlength="200"
                                   placeholder="Motivo de la anulación (obligatorio)" />
                        </div>
                        <div class="col-md-3 d-grid">
                            <button type="submit" class="btn btn-danger">Anular</button>
                        </div>
                    </form>
                </div>
            </div>
        }
        else if (esAdminSinMfa)
        {
            <div class="alert alert-warning mt-3 small">
                Para anular pedidos debes ingresar con verificación en dos pasos.
                <a href="/Identity/Account/Manage/TwoFactorAuthentication">Configurar 2FA</a>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        // Si otra pantalla cambia ESTE pedido (cocina, reparto), se recarga para mostrar su nuevo estado.
        document.addEventListener('alitasgo:pedido', function (e) {
            if (e.detail.idPedido !== @Model.IdPedido) return;
            var motivo = document.getElementById('motivo');
            if (motivo && motivo.value.trim() !== '') return;   // no perder lo que se está escribiendo
            location.reload();
        });
    </script>
}

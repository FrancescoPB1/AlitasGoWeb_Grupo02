@model PedidoCreateVM
@{
    var esEdicion = Model.IdPedido > 0;
    ViewData["Title"] = esEdicion ? $"Editar pedido #{Model.IdPedido}" : "Nuevo pedido";
}

<div class="page-header mb-4">
    <h1 class="h3">
        <i class="bi @(esEdicion ? "bi-pencil-square" : "bi-plus-square")" aria-hidden="true"></i> @ViewData["Title"]
    </h1>
    <p class="text-muted mb-0">
        Los precios, promociones y el total se calculan en el servidor al guardar.
        @if (esEdicion)
        {
            <span>Solo se puede editar mientras el pedido está <strong>Recibido</strong>.</span>
        }
    </p>
</div>

<form asp-action="@(esEdicion ? "Edit" : "Create")" asp-route-id="@(esEdicion ? Model.IdPedido : null)" method="post" data-una-vez>
    <div asp-validation-summary="All" class="alert alert-danger py-2" role="alert"></div>

    <div class="card mb-3">
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-7">
                    <label asp-for="IdCliente" class="form-label"></label>
                    <div class="input-group">
                        <select asp-for="IdCliente" asp-items="Model.Clientes" class="form-select">
                            <option value="">-- Selecciona --</option>
                        </select>
                        @if (!esEdicion)
                        {
                            <a asp-controller="Clientes" asp-action="Create" asp-route-volverAPedido="true"
                               class="btn btn-outline-secondary" title="Registrar cliente nuevo">
                                <i class="bi bi-person-plus" aria-hidden="true"></i> Nuevo
                            </a>
                        }
                    </div>
                    <span asp-validation-for="IdCliente" class="text-danger small"></span>
                </div>
                <div class="col-md-5">
                    <label asp-for="IdCanalAtencion" class="form-label"></label>
                    @if (esEdicion)
                    {
                        <input type="hidden" asp-for="IdCanalAtencion" />
                        <select id="canal" asp-items="Model.Canales" class="form-select" disabled
                                asp-for="IdCanalAtencion">
                        </select>
                    }
                    else
                    {
                        <select id="canal" asp-for="IdCanalAtencion" asp-items="Model.Canales" class="form-select">
                            <option value="">-- Selecciona --</option>
                        </select>
                    }
                    <span asp-validation-for="IdCanalAtencion" class="text-danger small"></span>
                </div>
            </div>

            <!-- Salón -->
            <div id="bloqueLocal" class="row g-3 mt-1 d-none">
                <div class="col-md-5">
                    <label asp-for="IdNroMesa" class="form-label"></label>
                    <select asp-for="IdNroMesa" asp-items="Model.Mesas" class="form-select">
                        <option value="">-- Selecciona --</option>
                    </select>
                </div>
            </div>

            <!-- Delivery -->
            <div id="bloqueDelivery" class="row g-3 mt-1 d-none">
                <div class="col-md-5">
                    <label asp-for="IdZonaDelivery" class="form-label"></label>
                    <select asp-for="IdZonaDelivery" asp-items="Model.Zonas" class="form-select">
                        <option value="">-- Selecciona --</option>
                    </select>
                </div>
                <div class="col-md-7">
                    <label asp-for="Direccion" class="form-label"></label>
                    <input asp-for="Direccion" class="form-control" autocomplete="off" />
                    <span asp-validation-for="Direccion" class="text-danger small"></span>
                </div>
                <div class="col-md-7">
                    <label asp-for="Referencia" class="form-label"></label>
                    <input asp-for="Referencia" class="form-control" placeholder="Ej.: casa del portón azul, frente a la bodega" autocomplete="off" />
                    <span asp-validation-for="Referencia" class="text-danger small"></span>
                </div>
                <div class="col-md-5">
                    <label asp-for="Telefono" class="form-label"></label>
                    <input asp-for="Telefono" class="form-control" inputmode="tel" autocomplete="off" />
                    <span asp-validation-for="Telefono" class="text-danger small"></span>
                </div>
            </div>
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-header bg-white d-flex justify-content-between align-items-center">
            <span class="fw-semibold">Detalle del pedido</span>
            <button type="button" id="btnAgregar" class="btn btn-sm btn-outline-primary">
                <i class="bi bi-plus-lg" aria-hidden="true"></i> Agregar producto
            </button>
        </div>
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead>
                    <tr>
                        <th>Producto</th>
                        <th style="width:14rem">Sabor</th>
                        <th style="width:7rem">Cantidad</th>
                        <th style="width:4rem"><span class="visually-hidden">Quitar</span></th>
                    </tr>
                </thead>
                <tbody id="filasDetalle">
                    @for (var i = 0; i < Model.Detalles.Count; i++)
                    {
                        <tr data-fila>
                            <td>
                                <select asp-for="Detalles[i].IdProducto" asp-items="Model.Productos" class="form-select js-producto" aria-label="Producto">
                                    <option value="0">-- Selecciona --</option>
                                </select>
                            </td>
                            <td>
                                <select asp-for="Detalles[i].IdSabor" asp-items="Model.Sabores" class="form-select js-sabor" aria-label="Sabor">
                                    <option value="">-- Sabor --</option>
                                </select>
                            </td>
                            <td>
                                <input asp-for="Detalles[i].Cantidad" type="number" min="1" max="@PedidoService.CantidadMaximaPorLinea" class="form-control" aria-label="Cantidad" />
                            </td>
                            <td class="text-end">
                                <button type="button" class="btn btn-outline-danger btn-sm js-quitar-fila" title="Quitar fila">
                                    <i class="bi bi-x-lg" aria-hidden="true"></i><span class="visually-hidden">Quitar</span>
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <template id="plantillaFila">
        <tr data-fila>
            <td>
                <select name="Detalles[__i__].IdProducto" id="Detalles___i____IdProducto" class="form-select js-producto" aria-label="Producto">
                    <option value="0">-- Selecciona --</option>
                    @foreach (var p in Model.Productos)
                    {
                        <option value="@p.Value">@p.Text</option>
                    }
                </select>
            </td>
            <td>
                <select name="Detalles[__i__].IdSabor" id="Detalles___i____IdSabor" class="form-select js-sabor" aria-label="Sabor" disabled>
                    <option value="">-- Sabor --</option>
                    @foreach (var s in Model.Sabores)
                    {
                        <option value="@s.Value">@s.Text</option>
                    }
                </select>
            </td>
            <td>
                <input name="Detalles[__i__].Cantidad" id="Detalles___i____Cantidad" type="number" min="1" max="@PedidoService.CantidadMaximaPorLinea" value="1" class="form-control" aria-label="Cantidad" />
            </td>
            <td class="text-end">
                <button type="button" class="btn btn-outline-danger btn-sm js-quitar-fila" title="Quitar fila">
                    <i class="bi bi-x-lg" aria-hidden="true"></i><span class="visually-hidden">Quitar</span>
                </button>
            </td>
        </tr>
    </template>

    <div class="d-flex justify-content-between">
        <a asp-action="@(esEdicion ? "Details" : "Index")" asp-route-id="@(esEdicion ? Model.IdPedido : null)" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left" aria-hidden="true"></i> Volver
        </a>
        <button type="submit" class="btn btn-primary btn-lg">
            <i class="bi bi-send" aria-hidden="true"></i> @(esEdicion ? "Guardar cambios" : "Registrar y enviar a cocina")
        </button>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            "use strict";
            var requiereSabor = @Json.Serialize(Model.ProductoRequiereSabor);
            var canal = document.getElementById('canal');

            function actualizarCanal() {
                var valor = canal.value;
                document.getElementById('bloqueLocal').classList.toggle('d-none', valor !== '@Canales.Salon');
                document.getElementById('bloqueDelivery').classList.toggle('d-none', valor !== '@Canales.Delivery');
            }

            // El sabor solo se habilita si el producto lo requiere (un select deshabilitado no se envía).
            function actualizarSabor(fila) {
                var producto = fila.querySelector('.js-producto').value;
                var sabor = fila.querySelector('.js-sabor');
                var requiere = requiereSabor[producto] === true;
                sabor.disabled = !requiere;
                sabor.required = requiere;
                if (!requiere) sabor.value = '';
            }

            canal.addEventListener('change', actualizarCanal);
            actualizarCanal();

            var cuerpo = document.getElementById('filasDetalle');
            cuerpo.querySelectorAll('[data-fila]').forEach(actualizarSabor);
            cuerpo.addEventListener('change', function (e) {
                if (e.target.classList.contains('js-producto')) actualizarSabor(e.target.closest('[data-fila]'));
            });

            AlitasGo.filasDinamicas({
                cuerpo: 'filasDetalle',
                plantilla: 'plantillaFila',
                botonAgregar: 'btnAgregar',
                prefijo: 'Detalles',
                alAgregar: actualizarSabor
            });
        })();
    </script>
}

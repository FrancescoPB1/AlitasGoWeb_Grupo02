@model CategoriaProducto
@{
    bool isEdit = ViewBag.IsEdit ?? false;
    ViewData["Title"] = isEdit ? "Editar categoría" : "Nueva categoría";
}

<div class="row justify-content-center">
    <div class="col-12 col-md-8 col-lg-6">

        <nav aria-label="breadcrumb" class="mb-3">
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a asp-action="Index">Categorías</a></li>
                <li class="breadcrumb-item active" aria-current="page">@ViewData["Title"]</li>
            </ol>
        </nav>

        <div class="card">
            <div class="card-header bg-white">
                <h1 class="h5 mb-0"><i class="bi bi-tags" aria-hidden="true"></i> @ViewData["Title"]</h1>
            </div>
            <div class="card-body">
                <form asp-action="@(isEdit ? "Edit" : "Create")" method="post" data-una-vez novalidate>
                    @* ModelOnly: solo errores generales devueltos por el servicio; los de campo van junto a cada input *@
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2" role="alert"></div>

                    @if (isEdit)
                    {
                        <input type="hidden" asp-for="IdCategoriaProducto" />
                    }

                    <div class="mb-3">
                        <label asp-for="Nombre" class="form-label">Nombre <span class="text-danger">*</span></label>
                        <input asp-for="Nombre" class="form-control" placeholder="Ej: Alitas, Complementos, Bebidas" autofocus />
                        <span asp-validation-for="Nombre" class="invalid-feedback d-block"></span>
                        <div class="form-text">Máximo 100 caracteres.</div>
                    </div>

                    @if (isEdit)
                    {
                        <div class="form-check form-switch mb-4">
                            <input asp-for="Activo" class="form-check-input" role="switch" />
                            <label asp-for="Activo" class="form-check-label">Categoría activa</label>
                        </div>
                    }

                    <div class="d-flex flex-column-reverse flex-sm-row justify-content-between gap-2">
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-check-lg" aria-hidden="true"></i>
                            @(isEdit ? "Guardar cambios" : "Crear categoría")
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

@{
    ViewData["Title"] = "Error";
}
<div class="card mx-auto text-center" style="max-width: 32rem;">
    <div class="card-body p-4">
        <i class="bi bi-emoji-frown display-4 text-danger" aria-hidden="true"></i>
        <h1 class="h4 mt-3">Algo salió mal</h1>
        <p class="text-muted">Ocurrió un error inesperado. Intenta de nuevo; si continúa, avisa a la administradora.</p>
        <a href="/" class="btn btn-primary">Volver al inicio</a>
    </div>
</div>

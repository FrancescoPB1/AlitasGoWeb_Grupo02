@{
    ViewData["Title"] = "Acceso denegado";
    var esAdmin = User.IsInRole(RolesSistema.Administrador);
}

<div class="card mx-auto text-center" style="max-width: 36rem;">
    <div class="card-body p-4">
        <i class="bi bi-shield-x display-4 text-danger" aria-hidden="true"></i>
        <h1 class="h4 mt-3">No tienes permiso para esta sección</h1>
        @if (esAdmin)
        {
            <p class="text-muted">
                Anular pedidos exige haber ingresado con <strong>verificación en dos pasos</strong>.
            </p>
            <ol class="text-start small">
                <li>Entra a <a href="/Identity/Account/Manage/TwoFactorAuthentication">Seguridad (2FA)</a> y configura la app autenticadora.</li>
                <li>Cierra sesión y vuelve a ingresar escribiendo el código de la app.</li>
            </ol>
        }
        else
        {
            <p class="text-muted">Tu rol no permite esta acción. El intento quedó registrado.</p>
        }
        <a asp-controller="Inicio" asp-action="Index" class="btn btn-primary mt-2">Ir a mi pantalla</a>
    </div>
</div>

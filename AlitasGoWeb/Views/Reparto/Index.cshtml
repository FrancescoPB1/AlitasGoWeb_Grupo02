@model List<Pedido>
@{
    ViewData["Title"] = "Reparto";
}

<div class="page-header d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3"><i class="bi bi-bicycle" aria-hidden="true"></i> Reparto</h1>
        <p class="text-muted mb-0">Pedidos delivery listos para salir y en camino · se actualiza en tiempo real.</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-clockwise" aria-hidden="true"></i> Actualizar</a>
</div>

<div id="contenedorReparto">
    <partial name="_Tablero" model="Model" />
</div>

@section Scripts {
    <script>
        AlitasGo.refrescarAlCambiar('contenedorReparto',
            function () { return '@Url.Action("Tablero")'; },
            function (aviso) { return aviso.idCanal === @Canales.Delivery; });
    </script>
}

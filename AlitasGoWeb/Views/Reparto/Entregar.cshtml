@model CobroVM
@{
    ViewData["Title"] = $"Entregar pedido #{Model.IdPedido}";
}

<div class="page-header mb-4">
    <h1 class="h3"><i class="bi bi-cash-coin" aria-hidden="true"></i> Entrega y cobro · pedido #@Model.IdPedido</h1>
    <p class="text-muted mb-0">Registra el pago contra entrega: el pedido pasa a Entregado.</p>
</div>

<div class="row g-3">
    <div class="col-lg-5 order-lg-2">
        <div class="card">
            <div class="card-body">
                @if (Model.Pedido != null)
                {
                    <partial name="_ResumenPedido" model="Model.Pedido" />
                    <hr />
                }
                <partial name="_FormCobro" model="Model" />
            </div>
        </div>
        <a asp-action="Index" class="btn btn-link mt-2"><i class="bi bi-arrow-left" aria-hidden="true"></i> Volver a reparto</a>
    </div>
    <div class="col-lg-7 order-lg-1">
        <div class="card">
            <div class="card-header bg-white fw-semibold">Detalle</div>
            @if (Model.Pedido != null)
            {
                <partial name="_DetalleLineas" model="Model.Pedido" />
            }
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

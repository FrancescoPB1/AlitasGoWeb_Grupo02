@model PresentacionProducto
@{
    bool isEdit = ViewBag.IsEdit ?? false;
    bool desdeProducto = ViewBag.DesdeProducto ?? false;
    string? productoNombre = ViewBag.ProductoNombre as string;
    ViewData["Title"] = isEdit ? "Editar presentación" : "Nueva presentación";
}

<div class="row justify-content-center">
    <div class="col-12 col-md-8 col-lg-6">

        <nav aria-label="breadcrumb" class="mb-3">
            <ol class="breadcrumb mb-0">
                @if (desdeProducto)
                {
                    <li class="breadcrumb-item"><a asp-controller="Producto" asp-action="Index">Productos</a></li>
                    <li class="breadcrumb-item"><a asp-action="Index" asp-route-idProducto="@Model.IdProducto">@productoNombre</a></li>
                }
                else
                {
                    <li class="breadcrumb-item"><a asp-action="Index">Presentaciones</a></li>
                }
                <li class="breadcrumb-item active" aria-current="page">@ViewData["Title"]</li>
            </ol>
        </nav>

        <div class="card">
            <div class="card-header bg-white">
                <h1 class="h5 mb-0"><i class="bi bi-box2" aria-hidden="true"></i> @ViewData["Title"]</h1>
            </div>
            <div class="card-body">
                <form asp-action="@(isEdit ? "Edit" : "Create")" method="post" data-una-vez novalidate>
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2" role="alert"></div>

                    <input type="hidden" name="desdeProducto" value="@desdeProducto.ToString().ToLower()" />
                    @if (isEdit)
                    {
                        <input type="hidden" asp-for="IdPresentacion" />
                    }

                    <div class="mb-3">
                        <label asp-for="IdProducto" class="form-label">Producto <span class="text-danger">*</span></label>
                        @if (desdeProducto && !isEdit)
                        {
                          
                            <input type="hidden" asp-for="IdProducto" />
                            <input type="text" class="form-control" value="@productoNombre" readonly aria-readonly="true" />
                        }
                        else
                        {
                            <select asp-for="IdProducto" asp-items="ViewBag.Productos" class="form-select">
                                <option value="">— Selecciona —</option>
                            </select>
                            <span asp-validation-for="IdProducto" class="invalid-feedback d-block"></span>
                        }
                    </div>

                    <div class="mb-3">
                        <label asp-for="NombrePresentacion" class="form-label">Nombre de la presentación <span class="text-danger">*</span></label>
                        <input asp-for="NombrePresentacion" class="form-control" placeholder="Ej: 6 unidades, Docena, Personal" autofocus />
                        <span asp-validation-for="NombrePresentacion" class="invalid-feedback d-block"></span>
                    </div>

                    <div class="row g-3">
                        <div class="col-12 col-sm-6">
                            <label asp-for="CantidadUnidad" class="form-label">Cantidad <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <input asp-for="CantidadUnidad" type="number" step="0.01" min="0.01" inputmode="decimal" class="form-control" placeholder="6" />
                                <span class="input-group-text">ud.</span>
                            </div>
                            <span asp-validation-for="CantidadUnidad" class="invalid-feedback d-block"></span>
                        </div>
                        <div class="col-12 col-sm-6">
                            <label asp-for="Precio" class="form-label">Precio <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text">S/</span>
                                <input asp-for="Precio" type="number" step="0.01" min="0.01" inputmode="decimal" class="form-control" placeholder="0.00" />
                            </div>
                            <span asp-validation-for="Precio" class="invalid-feedback d-block"></span>
                        </div>
                    </div>

                    <div class="form-check form-switch my-4">
                        <input asp-for="Activo" class="form-check-input" role="switch" />
                        <label asp-for="Activo" class="form-check-label">Presentación activa</label>
                        <div class="form-text">Desactívala si ya no está disponible en carta.</div>
                    </div>

                    <div class="d-flex flex-column-reverse flex-sm-row justify-content-between gap-2">
                        @if (desdeProducto)
                        {
                            <a asp-action="Index" asp-route-idProducto="@Model.IdProducto" class="btn btn-outline-secondary">Cancelar</a>
                        }
                        else
                        {
                            <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                        }
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-check-lg" aria-hidden="true"></i>
                            @(isEdit ? "Guardar cambios" : "Crear presentación")
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

@model Cliente
@{
    ViewData["Title"] = "Nuevo cliente";
    var volverAPedido = ViewData["VolverAPedido"] as bool? ?? false;
}

<div class="page-header mb-4">
    <h1 class="h3"><i class="bi bi-person-plus" aria-hidden="true"></i> Nuevo cliente</h1>
</div>

<div class="card" style="max-width: 40rem;">
    <div class="card-body">
        <form asp-action="Create" method="post" data-una-vez>
            <input type="hidden" name="volverAPedido" value="@(volverAPedido ? "true" : "false")" />
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2" role="alert"></div>
            <div class="mb-3">
                <label asp-for="DNI" class="form-label"></label>
                <input asp-for="DNI" class="form-control" inputmode="numeric" maxlength="8" autofocus />
                <span asp-validation-for="DNI" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Nombre" class="form-label"></label>
                <input asp-for="Nombre" class="form-control" />
                <span asp-validation-for="Nombre" class="text-danger small"></span>
            </div>
            <div class="row g-3 mb-3">
                <div class="col-sm-6">
                    <label asp-for="ApellidoPaterno" class="form-label"></label>
                    <input asp-for="ApellidoPaterno" class="form-control" />
                    <span asp-validation-for="ApellidoPaterno" class="text-danger small"></span>
                </div>
                <div class="col-sm-6">
                    <label asp-for="ApellidoMaterno" class="form-label"></label>
                    <input asp-for="ApellidoMaterno" class="form-control" />
                    <span asp-validation-for="ApellidoMaterno" class="text-danger small"></span>
                </div>
            </div>
            <div class="d-flex justify-content-between">
                <a asp-controller="@(volverAPedido ? "Pedidos" : "Clientes")" asp-action="@(volverAPedido ? "Create" : "Index")" class="btn btn-outline-secondary">Cancelar</a>
                <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg" aria-hidden="true"></i> Guardar</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

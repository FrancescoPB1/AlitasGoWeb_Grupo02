@model List<Cliente>
@{
    ViewData["Title"] = "Clientes";
}

<div class="page-header d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3 mb-4">
    <div>
        <h1 class="h3"><i class="bi bi-people" aria-hidden="true"></i> Clientes</h1>
        <p class="text-muted mb-0">Clientes registrados para salón y delivery.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary"><i class="bi bi-person-plus" aria-hidden="true"></i> Nuevo cliente</a>
</div>

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr><th>DNI</th><th>Nombre</th><th class="text-end">Acciones</th></tr>
            </thead>
            <tbody>
                @foreach (var c in Model)
                {
                    <tr>
                        <td>@c.DNI</td>
                        <td class="fw-semibold">@c.Nombre @c.ApellidoPaterno @c.ApellidoMaterno</td>
                        <td class="text-end">
                            <a asp-controller="Pedidos" asp-action="Create" asp-route-idCliente="@c.IdCliente" class="btn btn-sm btn-outline-primary">
                                <i class="bi bi-plus-square" aria-hidden="true"></i> Nuevo pedido
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
